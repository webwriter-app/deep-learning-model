<style>
    design {
        display: block;
        position: relative;
    }

    design div.drawflow {
        position: absolute;
        left: 0px;
        right: 0px;
        height: 100%;
        width: 100%;
    }

    design div.drawflow input {
        width: 50px;
    }

    design div.add {
        position: absolute;
        right: 0px;
        bottom: 0px;
    }
</style>
<!-- Basic element structure -->
<view>
    <div id="drawflow"></div>
    <div id="add">
        <p>I/O</p>
        <button id="addInput">Input</button>
        <button id="addMultInput">Multi-Input</button>
        <button id="addAccess">Access Point</button>
        <button id="addOutput">Output</button>
        <p>Deep Layers</p>
        <button id="addAct">Add Activation Layer</button>
        <button id="addFCL">Add Fully Connected Layer</button>
        <button id="addProb">Add Probabalistic Layer</button>
        <button id="addDrop">Add Dropout Layer</button>
        <p>Misc</p>
        <button id="addFlatten">Add Flattening Layer</button>
        <button id="addConcat">Add Concatination Layer</button>
        <button id="addDeconcat">Add DeConcatination Layer</button>
        <button id="addAdd">Add Add Layer</button>
        <p>Combination</p>
    </div>
</view>
<script place="client">
    let layers = setupLayerRenderer(ids.drawflow);
    let fieldProps;

    let currentLayers = [];
    ids.addInput.onclick = function () {
        let layer = new layers.InputLayer(fieldProps);
        currentLayers.push(layer);
    }
    ids.addOutput.onclick = function () {
        let layer = new layers.OutputLayer(fieldProps);
        currentLayers.push(layer);
    }
    ids.addFCL.onclick = function () {
        let layer = new layers.FCLLayer();
        currentLayers.push(layer);
    }
    ids.addFlatten.onclick = function () {
        let layer = new layers.FlattenLayer();
        currentLayers.push(layer);
    }
    ids.addConcat.onclick = function () {
        let layer = new layers.ConcatLayer();
        currentLayers.push(layer);
    }
    ids.addAct.onclick = function () {
        let layer = new layers.ActivationLayer();
        currentLayers.push(layer);
    }
    ids.addMultInput.onclick = function () {
        let layer = new layers.MultiInputLayer(fieldProps);
        currentLayers.push(layer);
    }
    ids.addDeconcat.onclick = function () {
        let layer = new layers.DeConcatLayer();
        currentLayers.push(layer);
    }
    ids.addAccess.onclick = function () {
        let layer = new layers.AccessPoint();
        currentLayers.push(layer);
    }
    ids.addProb.onclick = function () {
        let layer = new layers.ProbabalisticLayer();
        currentLayers.push(layer);
    }
    ids.addDrop.onclick = function () {
        let layer = new layers.DropoutLayer();
        currentLayers.push(layer);
    }
    ids.addAdd.onclick = function () {
        let layer = new layers.AddLayer();
        currentLayers.push(layer);
    }

    listen("update", function ({ model, props }) {
        fieldProps = props;
        layers.import(model, props)
    })
    send("id", PROJECTID);

    function saveModel() {
        let flowmodel = layers.export();
        console.log(JSON.stringify(flowmodel));
        send("save", flowmodel);
    }
    setInterval(saveModel, 2000);
</script>
<script place="server">
    let projects = require("./projects");

    let project = null;
    listen("id", function (id) {
        project = projects.getProject(id);
        send("update", { model: project.model || [{}], props: project.fieldProps })
    })

    listen("save", function (model) {
        project.model = model;
    })
</script>