{
    "name": "@webwriter/ai-blocks",
    "version": "0.0.1",
    "keywords": [
        "webwriter-widget"
    ],
    "license": "MIT",
    "author": "Matthias Schäfer",
    "scripts": {
        "prepublishOnly": "npx @webwriter/build",
        "dev": "npx @webwriter/build dev",
        "localize": "lit-localize extract && npx @webwriter/build localize && lit-localize build"
    },
    "dependencies": {
        "@shoelace-style/shoelace": "^2.20.1",
        "@tabler/icons": "^3.33.0",
        "@tensorflow/tfjs": "^4.22.0",
        "@tensorflow/tfjs-backend-wasm": "^4.22.0",
        "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
        "@webwriter/lit": "^2",
        "apexcharts": "^4.7.0",
        "drawflow": "^0.0.60",
        "hyparquet": "^1.16.2",
        "lit": "^3",
        "papaparse": "^5.5.3"
    },
    "devDependencies": {
        "@lit/localize-tools": "^0.8",
        "@types/drawflow": "^0.0.12"
    },
    "exports": {
        "./widgets/webwriter-typeselect.*": {
            "source": "./widgets/webwriter-typeselect.ts",
            "default": "./dist/widgets/webwriter-typeselect.*"
        },
        "./widgets/webwriter-feature-engineering.*": {
            "source": "./widgets/webwriter-feature-engineering.ts",
            "default": "./dist/widgets/webwriter-feature-engineering.*"
        },
        "./widgets/webwriter-model-designing.*": {
            "source": "./widgets/webwriter-model-designing.ts",
            "default": "./dist/widgets/webwriter-model-designing.*"
        },
        "./widgets/webwriter-model-training.*": {
            "source": "./widgets/webwriter-model-training.ts",
            "default": "./dist/widgets/webwriter-model-training.*"
        },
        "./widgets/webwriter-model-prediction.*": {
            "source": "./widgets/webwriter-model-prediction.ts",
            "default": "./dist/widgets/webwriter-model-prediction.*"
        },
        "./widgets/webwriter-model-evaluation.*": {
            "source": "./widgets/webwriter-model-evaluation.ts",
            "default": "./dist/widgets/webwriter-model-evaluation.*"
        },
        "./snippets/MNIST-Image-to-Number.html": "./snippets/MNIST.html"
    },
    "editingConfig": {
        ".": {
            "selectable": false,
            "label": {
                "_": "Deep Learning Playground"
            },
            "uninsertable": false
        }
    }
}