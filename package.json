{
    "name": "@matthiasschaefer/aiwidgets",
    "version": "0.0.1",
    "keywords": [
        "webwriter-widget"
    ],
    "license": "MIT",
    "author": "Matthias Schäfer",
    "scripts": {
        "prepublishOnly": "npx @webwriter/build",
        "dev": "npx @webwriter/build dev",
        "localize": "lit-localize extract && npx @webwriter/build localize && lit-localize build"
    },
    "dependencies": {
        "@shoelace-style/shoelace": "^2.20.1",
        "@tabler/icons": "^3.33.0",
        "@tensorflow/tfjs": "^4.22.0",
        "@webwriter/lit": "^2",
        "lit": "^3",
        "papaparse": "^5.5.3"
    },
    "devDependencies": {
        "@lit/localize-tools": "^0.8"
    },
    "exports": {
        "./widgets/matthiasschaefer-aiwidgets.*": {
            "source": "./widgets/matthiasschaefer-aiwidgets.ts",
            "default": "./dist/widgets/matthiasschaefer-aiwidgets.*"
        }
    }
}
