{
    "name": "@matthiasschaefer/aiwidgets",
    "version": "0.0.1",
    "keywords": [
        "webwriter-widget"
    ],
    "license": "MIT",
    "author": "Matthias Schäfer",
    "scripts": {
        "prepublishOnly": "npx @webwriter/build",
        "dev": "npx @webwriter/build dev",
        "localize": "lit-localize extract && npx @webwriter/build localize && lit-localize build"
    },
    "dependencies": {
        "@shoelace-style/shoelace": "^2.20.1",
        "@tabler/icons": "^3.33.0",
        "@tensorflow/tfjs": "^4.22.0",
        "@webwriter/lit": "^2",
        "lit": "^3",
        "papaparse": "^5.5.3"
    },
    "devDependencies": {
        "@lit/localize-tools": "^0.8"
    },
    "exports": {
        "./widgets/features.*": {
            "source": "./widgets/features.ts",
            "default": "./dist/widgets/features.*"
        },
        "./widgets/design.*": {
            "source": "./widgets/design.ts",
            "default": "./dist/widgets/design.*"
        },
        "./snippets/design.html": "./snippets/design.html",
        "./snippets/features.html": "./snippets/features.html"
    },
    "editingConfig": {
        ".": {
            "label": {
                "_": "AI Widgets"
            },
            "description": {
                "de": "Entwickle eine KI in 5 Schritten."
            },
            "uninsertable": true
        },
        "./snippets/features.html": {
            "selectable": true,
            "label": {
                "de": "Feature Engineering"
            },
            "group": "answer",
            "content": "webwriter-choice-item+",
            "uninsertable": true,
            "inline": false
        },
        "./snippets/design.html": {
            "selectable": true,
            "label": {
                "de": "Model Designing"
            },
            "group": "answer",
            "content": "webwriter-choice-item+",
            "uninsertable": true,
            "inline": false
        }
    }
}